# ==============================================================
# VLU Smart Assistant - Biến Môi Trường Mẫu (.env.example)
# ==============================================================

# Backend Node.js Express Port
PORT=5001
NODE_ENV=development

# CẤU HÌNH NGUỒN DỮ LIỆU: 'auto' | 'demo' | 'mongodb'
DATA_MODE=auto

# Đường dẫn file dữ liệu demo (để trống sẽ dùng mặc định: server/data/demo/demo_store.json)
DEMO_DATA_PATH=

# Kết nối cơ sở dữ liệu MongoDB (Mongoose)
# Local: mongodb://127.0.0.1:27017/vlu_bot
# Cloud Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vlu_bot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vlu_bot

# Địa chỉ Frontend React (CORS)
CLIENT_URL=http://localhost:5173

# Cấu hình bảo mật JWT Token (Tối thiểu 32 ký tự ngẫu nhiên)
JWT_SECRET=vlu_smart_assistant_super_secret_jwt_key_2025_cnh
JWT_EXPIRES_IN=7d

# Khóa Gemini AI API (Lấy từ Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
