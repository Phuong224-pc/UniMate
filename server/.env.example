# Cấu hình cổng chạy máy chủ Node.js Express
PORT=5001
NODE_ENV=development

# ==========================================
# CẤU HÌNH NGUỒN DỮ LIỆU (DATA_MODE):
# - 'auto': Thử kết nối MongoDB trong 3.5s; nếu chưa bật/không kết nối được -> tự chuyển sang DEMO LOCAL.
# - 'demo': Luôn dùng kho dữ liệu Demo Local (JSON an toàn, tuần tự), KHÔNG thử kết nối MongoDB.
# - 'mongodb': Bắt buộc dùng MongoDB; nếu mất kết nối -> báo lỗi rõ và dừng, không chuyển sang demo.
# ==========================================
DATA_MODE=auto

# Đường dẫn file dữ liệu demo (để trống sẽ dùng mặc định: server/data/demo/demo_store.json)
DEMO_DATA_PATH=

# Kết nối cơ sở dữ liệu MongoDB
# Dùng chuỗi kết nối cục bộ (Local): mongodb://127.0.0.1:27017/vlu_bot
# Hoặc MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/vlu_bot?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/vlu_bot

# Địa chỉ URL của Frontend React (để cấu hình CORS)
CLIENT_URL=http://localhost:5173

# Cấu hình bảo mật JWT Token cho sinh viên và quản trị viên
JWT_SECRET=your_jwt_secret_key_here_at_least_32_characters
JWT_EXPIRES_IN=7d

# Khóa Gemini AI API (Lấy từ Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here
