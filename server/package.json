{
  "name": "vlu-bot-server",
  "version": "1.0.0",
  "description": "Backend API for VLU Smart Assistant AI",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:integration": "node scripts/testDataModes.js && node scripts/testNewFeatures.js",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "dev:mongo": "node --watch -e \"process.env.DATA_MODE='mongodb'; import('./src/index.js');\"",
    "migrate": "node scripts/migrate.js",
    "seed": "node scripts/migrate.js"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.3",
    "multer": "^2.5.0",
    "pdf-parse": "^2.4.5",
    "xlsx": "^0.18.5"
  }
}
